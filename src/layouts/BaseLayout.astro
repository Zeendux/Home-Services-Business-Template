---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Home services website template for HVAC, plumbing, and electrical businesses.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <style>
      :root {
        color-scheme: light;
        --bg: #f5f7fb;
        --surface: #ffffff;
        --text: #1f2937;
        --muted: #6b7280;
        --primary: #0b6ccf;
        --primary-soft: #e8f2fe;
        --border: #dbe4f0;
      }

      body {
        margin: 0;
        font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
        background: var(--bg);
        color: var(--text);
      }

      .container {
        width: min(1060px, 92vw);
        margin-inline: auto;
      }

      header {
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        z-index: 10;
      }

      nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 70px;
        gap: 1rem;
      }

      .logo {
        font-weight: 800;
        text-decoration: none;
        color: var(--text);
      }

      .links {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
      }

      .links a {
        text-decoration: none;
        color: var(--text);
        font-weight: 600;
      }

      main {
        padding-block: 2rem 3rem;
      }

      h1,
      h2,
      h3 {
        line-height: 1.2;
      }

      .card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 1rem;
        padding: 1.25rem;
      }

      footer {
        border-top: 1px solid var(--border);
        padding: 1.5rem 0 2.5rem;
        color: var(--muted);
      }

      .button {
        display: inline-block;
        background: var(--primary);
        color: white;
        text-decoration: none;
        font-weight: 700;
        border-radius: 0.75rem;
        padding: 0.75rem 1rem;
      }
    </style>
  </head>
  <body>
    <header>
      <div class="container">
        <nav>
          <a class="logo" href="/">HomePro Services</a>
          <div class="links">
            <a href="/">Home</a>
            <a href="/services/hvac">HVAC</a>
            <a href="/services/plumbing">Plumbing</a>
            <a href="/services/electrical">Electrical</a>
            <a href="/blog">Blog</a>
          </div>
        </nav>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer>
      <div class="container">© {new Date().getFullYear()} HomePro Services. All rights reserved.</div>
    </footer>
  </body>
</html>
